{:deps   {:aliases [:cljs]}
 :builds {;; clojure -M:cljs compile test
          :test  {:target    :node-test
                  :output-to "target/node-tests.js"
                  :ns-regexp "-test$"
                  :autorun   true}
          ;; clojure -M:cljs release bench && node target/bench.js
          :bench {:target    :node-script
                  :output-to "target/bench.js"
                  :main      dk.simongray.webvtt.bench/-main}
          ;; dev/size.sh  (the browser bundle of each set of functions that
          ;; a page may use, which the script adds to this one, ClojureScript
          ;; alone)
          :size  {:target     :esm
                  :output-dir "target/size"
                  :modules    {:main {:exports {base cljs.core/str}}}}}}
